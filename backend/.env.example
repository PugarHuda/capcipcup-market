# CapCipCup Backend Environment Variables

# Required: Your Mezo Testnet wallet address that receives MUSD payments
EVM_ADDRESS=0xYOUR_RECEIVING_WALLET_ADDRESS

# Required: Private key for contract interactions (deployer wallet)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# AI Provider Keys (get free tier at console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key
HUGGINGFACE_API_KEY=hf_your_huggingface_key

# Contract addresses (fill after deploying contracts)
SERVICE_REGISTRY_ADDRESS=0x...
AGENT_VAULT_ADDRESS=0x...
REVIEW_SYSTEM_ADDRESS=0x...

# Optional overrides
PORT=3000
FACILITATOR_URL=https://facilitator.vativ.io/
FRONTEND_URL=http://localhost:3001
