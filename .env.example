# ============================================================
# CapCipCup Market — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# --- Wallet ---
# Mezo Testnet wallet that receives MUSD payments AND deploys contracts
EVM_ADDRESS=0xYOUR_WALLET_ADDRESS
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# --- AI Provider Keys ---
# Get free Groq key at: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
# Get free HuggingFace key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_key_here

# --- Contract Addresses (fill after deploying) ---
SERVICE_REGISTRY_ADDRESS=
AGENT_VAULT_ADDRESS=
REVIEW_SYSTEM_ADDRESS=
MOCK_MEZO_ADDRESS=

# --- Mezo Testnet Constants ---
MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
FACILITATOR_URL=https://facilitator.vativ.io/

# --- Server ---
PORT=3000
FRONTEND_URL=http://localhost:3001

# --- Agent (stretch goal) ---
AGENT_PRIVATE_KEY=0xAGENT_HOT_WALLET_KEY
VAULT_OWNER_ADDRESS=0xYOUR_WALLET_ADDRESS
INTERVAL_MS=30000
